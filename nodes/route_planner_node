#!/usr/bin/env python

import rospy
from std_msgs.msg import Float64


class RoutePlannerNode(object):
    def __init__(self):
        rospy.init_node('look_away')

        self.pub1 = rospy.Publisher('/vector_map', Float64)

        rospy.spin()


if __name__ == '__main__':
    try:
        RoutePlannerNode()
    except rospy.ROSInterruptException:
        pass

